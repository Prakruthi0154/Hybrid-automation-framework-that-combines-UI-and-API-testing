<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Framework CI Suite" parallel="methods" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.example.ecommerce.listeners.FrameworkListener"/>
    </listeners>
    <test name="Framework Checks">
        <groups><run><include name="framework"/></run></groups>
        <classes><class name="com.example.ecommerce.tests.FrameworkSmokeTest"/></classes>
    </test>
</suite>
